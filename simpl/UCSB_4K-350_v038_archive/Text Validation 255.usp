#SYMBOL_NAME "Text Validation 255"
// #HINT ""
// #DEFINE_CONSTANT
// #CATEGORY "" 
// #DEFAULT_VOLATILE
// #DIGITAL_EXPAND 
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
#DEFAULT_NONVOLATILE
#ENABLE_STACK_CHECKING
#ANALOG_SERIAL_EXPAND AllWithAny
#DIGITAL_EXPAND AllWithAny

// ANALOG_INPUT 
STRING_INPUT Text$[255][255];
// BUFFER_INPUT 

DIGITAL_OUTPUT Text_Valid[255];
// ANALOG_OUTPUT 

INTEGER X;



CHANGE Text$
{
	Text_Valid[GetLastModifiedArrayIndex()] = len(Text$[GetLastModifiedArrayIndex()]);
}



