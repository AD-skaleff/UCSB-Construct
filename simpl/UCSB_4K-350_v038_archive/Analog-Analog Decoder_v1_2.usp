#SYMBOL_NAME "Analog To Analog Decoder v1_2"
// #HINT ""
#DEFINE_CONSTANT MAX_ITEMS 200
// #CATEGORY "" 
// #DEFAULT_VOLATILE
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
#DEFAULT_NONVOLATILE
#ANALOG_SERIAL_EXPAND Separately

// ANALOG_INPUT 
ANALOG_INPUT aiArgument[MAX_ITEMS], aIndex_Val[MAX_ITEMS];
// BUFFER_INPUT 

ANALOG_OUTPUT aoIndex_Argument[MAX_ITEMS];
INTEGER iAnalog_Num,x;

Function fEvalIndex(integer x)
{
	if (aIndex_Val[x])
	{
		aoIndex_Argument[x] = aiArgument[aIndex_Val[x]];
	}
	else
		aoIndex_Argument[x] = 0;
}

Function fEvalArgument(integer x)
{
	integer i;

 	for (i=1 to iAnalog_Num)
	{
		if (aIndex_Val[i]=x)
		{
			if (IsSignalDefined(aiArgument[aIndex_Val[i]]))
			{
				aoIndex_Argument[i] = aiArgument[aIndex_Val[i]];
			}
		}
	}
}


CHANGE aiArgument
{
	fEvalArgument(getlastmodifiedarrayindex());
}


Change aIndex_Val
{
    fEvalIndex(getlastmodifiedarrayindex());
}


Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.
	integer i;

    WaitForInitializationComplete();

	For (i=MAX_ITEMS to 1 Step -1)
	{
     	If(IsSignalDefined(aIndex_Val[i]))
			Break;
	}iAnalog_Num = i;

}


