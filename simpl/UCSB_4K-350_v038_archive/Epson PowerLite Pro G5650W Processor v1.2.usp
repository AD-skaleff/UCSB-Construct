#SYMBOL_NAME "Epson PowerLite Pro G5650W Processor v1.2"
// #HINT ""
// #DEFINE_CONSTANT
#DEFAULT_VOLATILE
// #DEFAULT_NONVOLATILE

#HELP_BEGIN
This SMPL+ module is only to be used in conjuction
with the Epson PowerLite Pro G5650W v1.0 module.

v1.1 - Best practices for threadsafety and 3-series
v1.2 - Series 4 support
#HELP_END


/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional librarys as needed)
*******************************************************************************************/
// #CRESTRON_LIBRARY ""
// #USER_LIBRARY ""

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
//DIGITAL_INPUT 
//ANALOG_INPUT 
//STRING_INPUT 
BUFFER_INPUT FROM_DEVICE$[200];
//DIGITAL_OUTPUT 
//STRING_OUTPUT 
ANALOG_OUTPUT Contrast, Brightness, Color, Tint, Sharpness, Volume, Lamp;
               
/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
*******************************************************************************************/
INTEGER SEMAPHORE;
STRING TEMP$[50], sParse[100];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/


/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
#IF_SERIES2

THREADSAFE CHANGE FROM_DEVICE$
{
	While(1)
	{
 		sParse = Gather("\x0D",FROM_DEVICE$); 
      			IF(FIND("=", sParse) > 0)
     				{
        				Temp$=Remove("\x0D", sParse);
                        IF(FIND("CONTRAST", Temp$) > 0)
							{
								CONTRAST = ATOI(Temp$);
							}
						ELSE IF(FIND("BRIGHT", Temp$) > 0)
				 			{
								BRIGHTNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("DENSITY", Temp$) > 0)
				 			{
								COLOR = ATOI(Temp$);
							}
						ELSE IF(FIND("TINT", Temp$) > 0)
				 			{
								TINT = ATOI(Temp$);
							}
						ELSE IF(FIND("SHARP", Temp$) > 0)
				 			{
								SHARPNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("VOL", Temp$) > 0)
				 			{
								VOLUME = ATOI(Temp$);
							}
						ELSE IF(FIND("LAMP", Temp$) > 0)
				 			{
								Lamp = ATOI(Temp$);
							}
						CLEARBUFFER(Temp$);													
					}
		}
}

#ENDIF

#IF_SERIES3

THREADSAFE CHANGE FROM_DEVICE$
{
	While(1)
	{
		try
		{
 			sParse = Gather("\x0D",FROM_DEVICE$); 
      			IF(FIND("=", sParse) > 0)
     				{
        				Temp$=Remove("\x0D", sParse);
                        IF(FIND("CONTRAST", Temp$) > 0)
							{
								CONTRAST = ATOI(Temp$);
							}
						ELSE IF(FIND("BRIGHT", Temp$) > 0)
				 			{
								BRIGHTNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("DENSITY", Temp$) > 0)
				 			{
								COLOR = ATOI(Temp$);
							}
						ELSE IF(FIND("TINT", Temp$) > 0)
				 			{
								TINT = ATOI(Temp$);
							}
						ELSE IF(FIND("SHARP", Temp$) > 0)
				 			{
								SHARPNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("VOL", Temp$) > 0)
				 			{
								VOLUME = ATOI(Temp$);
							}
						ELSE IF(FIND("LAMP", Temp$) > 0)
				 			{
								Lamp = ATOI(Temp$);
							}
						CLEARBUFFER(Temp$);													
					}
				}
			catch
			{
             	Print("Error Processing Data from CHANGE From_Device$ handler\n");
			}
		}
}

#ENDIF

#IF_SERIES4

THREADSAFE CHANGE FROM_DEVICE$
{
	While(1)
	{
		try
		{
 			sParse = Gather("\x0D",FROM_DEVICE$); 
      			IF(FIND("=", sParse) > 0)
     				{
        				Temp$=Remove("\x0D", sParse);
                        IF(FIND("CONTRAST", Temp$) > 0)
							{
								CONTRAST = ATOI(Temp$);
							}
						ELSE IF(FIND("BRIGHT", Temp$) > 0)
				 			{
								BRIGHTNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("DENSITY", Temp$) > 0)
				 			{
								COLOR = ATOI(Temp$);
							}
						ELSE IF(FIND("TINT", Temp$) > 0)
				 			{
								TINT = ATOI(Temp$);
							}
						ELSE IF(FIND("SHARP", Temp$) > 0)
				 			{
								SHARPNESS = ATOI(Temp$);
							}
						ELSE IF(FIND("VOL", Temp$) > 0)
				 			{
								VOLUME = ATOI(Temp$);
							}
						ELSE IF(FIND("LAMP", Temp$) > 0)
				 			{
								Lamp = ATOI(Temp$);
							}
						CLEARBUFFER(Temp$);													
					}
				}
			catch
			{
             	Print("Error Processing Data from CHANGE From_Device$ handler\n");
			}
		}
}

#ENDIF





/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
    SEMAPHORE=0;
    CLEARBUFFER(FROM_DEVICE$);
    	
}


 