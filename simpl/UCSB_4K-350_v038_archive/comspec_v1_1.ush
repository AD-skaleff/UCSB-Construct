  Cmn1=* = default if given value is out of range.\\\\ANALOG_INPUT Port;\\
  Cmn2=*	'A'		Port A\\	'B'		Port B\\	'C'		Port C\\	'D'		Port D\\	'E'		Port||1
  Cmn3=E\\	'F'		Port F\\\\	'1'     Port 1\\	'2'     Port 2\\	'3'     Port||1
  Cmn4=3\\    '4'     Port 4\\	'5'     Port 5\\	'6'     Port 6\\\\ Note||1
  Cmn5=- In "Analog Initialize" you can type in 'A' for Port A, etc.\\	
  Cmn6=\\ANALOG_INPUT Baud_Rate;\\	VALUE	MEANING  \\	-1d		MIDI\\	-2d		SMPTE\\
  Cmn7=	-3d		HMWORK\\	-4d		GRAFIK\\	300d		300\\	600d	600\\	1200d	1200\\
  Cmn8=	1800d	1800\\	2400d	2400\\	3600d	3600\\	4800d	4800\\	7200d	7200\\
  Cmn9=*	9600d	9600\\	14400d	14000\\	19200d	19200\\	28800d	28000\\	38400d	
  Cmn10=38400\\	57600d	57600\\	115d	115200		\\	\\ Note - In "Analog Initialize"||1
  Cmn11=you can type in -1d for a negative number.\\\\ANALOG_INPUT Parity;\\
  Cmn12=*	'N'		None\\	'E'		Even\\	'Z'		Zero Stick\\	'O'		Odd\\	\\ANALOG_INPUT||1
  Cmn13=Data_Bits;\\	7d		7\\*	8d		8\\	\\ANALOG_INPUT Stop_Bits;\\*	1d		1\\
  Cmn14=	2d		2\\\\ANALOG_INPUT SoftHandShake;\\*	0d		None\\	1d		XON/XOFF\\
  Cmn15=	2d		XONT\\	3d		XONR\\		\\ANALOG_INPUT HardHandShake;\\*	0d		None\\
  Cmn16=	1d		RTS\\	2d		CTS\\	3d		RTS/CTS\\\\ANALOG_INPUT Protocol;\\*	0d	
  Cmn17=	RS-232\\	1d		RS-422\\	2d		RS-485\\\\DIGITAL_INPUT ReportCTS;\\	
  Cmn18=Digital signal - \\		1		Reports a change on the CTS line to the||1
  Cmn19=COM symbol\\		0		Suppresses the change report.\\\\DIGITAL_INPUT||1
  Cmn20=SendComspec;\\	Digital signal - on rising edge, assembles the comspec||1
  Cmn21=and sends it on Out$\\\\STRING_OUTPUT Out$;\\	The comspec, this||1
  Cmn22=goes to a "Packet Helper" symbol for transmission.\\
[END]
