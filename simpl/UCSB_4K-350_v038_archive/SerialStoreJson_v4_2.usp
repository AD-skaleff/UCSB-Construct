/*******************************************************************************************
  Compiler Directives
  (Uncomment and declare compiler directives as needed)
*******************************************************************************************/
#USER_SIMPLSHARP_LIBRARY "JsonFile_v4"

#DEFAULT_VOLATILE
#ENABLE_TRACE
#ENABLE_STACK_CHECKING
#ANALOG_SERIAL_EXPAND InputsWithOutputs
                             
#DEFINE_CONSTANT MAXITEMS 200
#DEFINE_CONSTANT MAXSIZE 255


#HELP_BEGIN
	Intialize File must be pusled after "NoFile" goes high.  This provided the opportunity to initizlie a file with multiple values at startup

	v4_2 - fixed directory syntax, added file identifier logic, added initialize logic

#HELP_END


/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
    
STRING_INPUT	FileName$[50], FileFolder$[50], FileIdentifier$[50];

DIGITAL_INPUT	ReadOptions,WriteOptions,WriteIndex,InitializeFile;
ANALOG_INPUT	_skip_;
STRING_INPUT	siDescriptions[MAXITEMS][MAXSIZE];
STRING_INPUT	siValues[MAXITEMS][MAXSIZE];

DIGITAL_OUTPUT	ReadComplete, WriteComplete, NoFile;
DIGITAL_OUTPUT  isInitialized,_skip_,_skip_,_skip_,_skip_;
STRING_OUTPUT   soDescriptions[MAXITEMS];
STRING_OUTPUT	soValues[MAXITEMS];

/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/

STRING  _directory[255], _values[255][201], _descriptions[255][201];
INTEGER iWriteIndex; // isInitialized;

SerialStoreList mySerialStoreList;

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
Function fSetDirectory()
{
	string generateFolder[50];
    
	// set folder
	if(len(FileFolder$) > 0)
	{
		mySerialStoreList.FileFolder = FileFolder$;
	}
	else
	{
		generateFolder = MakeProgramFilename("");
		mySerialStoreList.FileFolder = generateFolder;
	}

	// check for file identifier	                  
	if (len(FileIdentifier$))
	{
		mySerialStoreList.FileIdentifier = FileIdentifier$;
	}
	else if(len(FileName$) && len(FileFolder$))
	{
       	makestring(_directory,"/NVRAM/%s/%s",FileFolder$,FileName$);
	}
	else 
	{
		generateFolder = MakeProgramFilename("");
		makestring  (_directory,"/NVRAM/%s%s",
		generateFolder,
		FileName$
					);
	}
	
	mySerialStoreList.Filename = _directory;
	Trace("Directory %s",_directory);
}

Function fInitialFile()
{
	integer i;
	for(i = 1 to MAXITEMS)
	{
		if(len(_values[i]) > 0 && len(_descriptions[i]) > 0)
		{
			mySerialStoreList.SetSerial(i, _values[i], _descriptions[i]);	
		}
	}
	mySerialStoreList.WriteFile();
}





function Init()
{
    registerevent(mySerialStoreList,ReturnItems,myReturnItems);
	registerevent(mySerialStoreList,ReturnIndex,myReturnIndex);
	mySerialStoreList.MaxItems = MAXITEMS;
    registerdelegate(mySerialStoreList,delFile,myFileStatus);
   	fSetDirectory();
}

callback function myFileStatus (integer fileStatus)
{
	switch(fileStatus)
	{
		case (1):		//no file
		{                                                  
			NoFile = 1;
			ReadComplete = 0;
			WriteComplete = 0;
			isInitialized = 0;
        }
        case (2):  //read complete
		{
   			NoFile = 0;
			pulse(20,ReadComplete);
			WriteComplete = 0;
			isInitialized = 1;
		}
        case (3): //write complete
		{
   			NoFile = 0;
			ReadComplete = 0;
			pulse(20,WriteComplete);
		}
	} 	
}


eventhandler myReturnItems(SerialStoreList sender, ReturnItemsEventArgs args)
{
    integer i;
    if (sender = mySerialStoreList)
    {
      for(i = 1 to MAXITEMS)
      {
          soValues[i] = args.Value[i-1];
		  soDescriptions[i] = args.Description[i-1];        
	  }
    }

}

eventhandler myReturnIndex(SerialStoreList sender, ReturnIndexEventArgs args)
{
	soValues[args.Index] = args.Value;
	soDescriptions[args.Index] = args.Description;        
}

push InitializeFile
{
	fInitialFile();
}


push WriteOptions
{
	fSetDirectory();
   	mySerialStoreList.WriteFile();
}

push WriteIndex
{
	fSetDirectory();
    mySerialStoreList.WriteIndex(iWriteIndex);
}

push ReadOptions
{
	fSetDirectory();
    mySerialStoreList.ReadFile();
}

Change siValues
{
	if(isInitialized = 1)
	{
		if(len(siValues[getlastmodifiedarrayindex()]) = 0)
		{
			siValues[getlastmodifiedarrayindex()] = "Value";
		}
		if(len(siDescriptions[getlastmodifiedarrayindex()]) = 0)
		{
			siDescriptions[getlastmodifiedarrayindex()] = "Description";
		}
		mySerialStoreList.SetSerial(getlastmodifiedarrayindex(), siValues[getlastmodifiedarrayindex()], siDescriptions[getLastmodifiedarrayindex()]);
		iWriteIndex = getlastmodifiedarrayindex();
	}
	else //store to an array
	{
		if(len(siValues[getlastmodifiedarrayindex()]) = 0)
		{
			siValues[getlastmodifiedarrayindex()] = "Value";
		}
		_values[getlastmodifiedarrayindex()] = siValues[getlastmodifiedarrayindex()];		
	}

}
Change siDescriptions
{
	if(isInitialized = 1)
	{
		if(len(siValues[getlastmodifiedarrayindex()]) = 0)
		{
			siValues[getlastmodifiedarrayindex()] = "Value";
		}
		if(len(siDescriptions[getlastmodifiedarrayindex()]) = 0)
		{
			siDescriptions[getlastmodifiedarrayindex()] = "Description";
		}
		mySerialStoreList.SetSerial(getlastmodifiedarrayindex(), siValues[getlastmodifiedarrayindex()], siDescriptions[getLastmodifiedarrayindex()]);
		iWriteIndex = getlastmodifiedarrayindex();
	}
	else //store to an array
	{
		if(len(siDescriptions[getlastmodifiedarrayindex()]) = 0)
		{
			siDescriptions[getlastmodifiedarrayindex()] = "Description";
		}
		_descriptions[getlastmodifiedarrayindex()] = siDescriptions[getlastmodifiedarrayindex()];
		
	}
}

