/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
INTEGER Defined;
// LONG_INTEGER
// SIGNED_INTEGER
// SIGNED_LONG_INTEGER
STRING RoomConfigResponse[10000];

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
Function RequestConfig()
{
	MakeString(RoomConfigRequest$,"<RequestRoomConfiguration><RequestID>ConfigRequest%05u<\x2FRequestID><\x2FRequestRoomConfiguration>", Random(1, 65535));
}

Function ParseConfigResponse()
{
	Integer i, Pointer1, Pointer2; 
	String SearchProp[100];
	
	For(i = 1 to Defined)
	{
		MakeString(SearchProp, "<CustomField ID=\x22%s\x22>", CustomPropertyIDs[i]);		
		Pointer1 = Find(SearchProp, RoomConfigResponse);
		
		If(Pointer1)
		{
			Pointer1 = Find("<CustomFieldValue>", RoomConfigResponse, Pointer1) + 18;
			Pointer2 = Find("<\x2FCustomFieldValue>", RoomConfigResponse, Pointer1);		
			CustomPropertyValues$[i] = Mid(RoomConfigResponse, Pointer1, Pointer2 - Pointer1);
		}
		Else
		{
			If(EnableNotFoundFB)
			{
				MakeString(CustomPropertyValues$[i],"NOT FOUND - \x22%s\x22", CustomPropertyIDs[i]); 
			}
			Else
			{
				CustomPropertyValues$[i] = "";			
			}
		}			
	}		
}
