/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH Request$
{
    RequestConfig();
}


/*
RELEASE input
{
    // TODO:  Add code here
}
*/


Threadsafe CHANGE RoomConfigResponse$
{
	While(1)
	{
		RoomConfigResponse = Gather("<\x2FRoomConfigurationResponse>", RoomConfigResponse$);		
	
		ParseConfigResponse();
	/*
		While(Find(">", RoomConfigResponse))
		{
			CustomPropertyValues$[1] = Remove(">", RoomConfigResponse); 		
		}
	*/
	}    
}


