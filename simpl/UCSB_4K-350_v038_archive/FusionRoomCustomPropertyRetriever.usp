*******************************************************************************************/
DIGITAL_INPUT _SKIP_, _SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_,Request$;
// ANALOG_INPUT 
// STRING_INPUT 
BUFFER_INPUT RoomConfigResponse$[10000];

// DIGITAL_OUTPUT 
// ANALOG_OUTPUT 
STRING_OUTPUT RoomConfigRequest$, CustomPropertyValues$[MAXAMOUNT];

/*******************************************************************************************
  SOCKETS
  (Uncomment and define socket definitions as needed)
*******************************************************************************************/
// TCP_CLIENT
// TCP_SERVER
// UDP_SOCKET

