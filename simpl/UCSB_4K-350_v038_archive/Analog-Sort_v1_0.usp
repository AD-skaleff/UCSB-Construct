#SYMBOL_NAME "Analog Sort v1_0"
// #HINT ""
#DEFINE_CONSTANT MAX_ITEMS 24
// #CATEGORY "" 
// #DEFAULT_VOLATILE
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
#DEFAULT_NONVOLATILE
#ANALOG_SERIAL_EXPAND Separately

// ANALOG_INPUT 
STRING_INPUT siArgument[MAX_ITEMS][50];
ANALOG_INPUT aIndex_Val[MAX_ITEMS];
// BUFFER_INPUT 

STRING_OUTPUT soSorted_Argument[MAX_ITEMS];
INTEGER iAnalog_Num,x;

Function fEvalIndex()
{
	integer i;
	for (i=1 to iAnalog_Num)
	{
         soSorted_Argument[i] = "";
	}
	for (i=1 to iAnalog_Num)
	{
		if (aIndex_Val[i])
		{
			if (aIndex_Val[i])
			{
				soSorted_Argument[aIndex_Val[i]] = siArgument[i];
			}
		}
	}
}




CHANGE siArgument
{
	fEvalIndex();
}


Change aIndex_Val
{
    fEvalIndex();
}


Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.
	integer i;

    WaitForInitializationComplete();

	For (i=MAX_ITEMS to 1 Step -1)
	{
     	If(IsSignalDefined(aIndex_Val[i]))
			Break;
	}iAnalog_Num = i;

}


