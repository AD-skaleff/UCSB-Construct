// #HINT ""
// #CATEGORY "" 
// #DEFAULT_VOLATILE
// #ANALOG_SERIAL_EXPAND 
// #OUTPUT_SHIFT 
#ENABLE_TRACE

BUFFER_INPUT Rx$[255];

STRING_OUTPUT Rx$g;

STRING sTemp[1];
        
THREADSAFE CHANGE Rx$
{
	if(find("\x1D",Rx$) = 0)
	{
		clearbuffer(Rx$);
	}
	else
	{	
		while(find("\x1D",Rx$))
		{
			try
			{
			    Rx$g =	gatherbylength(3,Rx$);
			}
			catch
			{
    	     	print("Exception %s",GetExceptionMessage());
			}
		}
	}
}


